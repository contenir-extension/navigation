<?php
/**
 * The Navigation section's home: the page header with Add menu, a switcher of the site's menus,
 * and the chosen menu's card: its title with where it stands (not live until published once, then
 * live), its identifier to copy and its note; at its top right Edit menu, Publish until it is live
 * and a menu of the rest (History, then Delete menu), with when it was updated beneath, linking to its history;
 * and its tree of items, each with its own actions.
 *
 * @var array{
 *     menus: list<array{id: int, title: string, current: bool}>,
 *     menu: array{
 *         id: int|null,
 *         title: string,
 *         handle: string,
 *         description: string|null,
 *         state: array{live: bool, published: string|null, by: string|null, changes: int},
 *         tree: list<array<string, mixed>>,
 *     }|null,
 * } $values
 * @var \Contenir\Extension\Api\Module\TemplateHelpersInterface $view
 */
$menu = $values['menu'];
?>
                <div class="pageheader pageheader--row pageheader--sticky">
                    <div class="pageheader__content">
                        <h1 class="pageheader__title">Navigation</h1>
                    </div>
                    <div class="pageheader__actions">
                        <a class="btn btn--outline" href="<?= $view->escape($view->url('menu-add')) ?>"><?= $view->icon('plus') ?><span>Add menu</span></a>
                    </div>
                </div>
                <p class="pageheader__description">Build the site's menus. Publish a menu once to put it on the site; after that, changes go live as you save them.</p>

<?php if (null === $menu): ?>
                <div class="card">
                    <div class="card__content card__content--pt">
                        <div class="empty">
                            <div class="empty__content">
                                <h2 class="empty__title">No menus yet</h2>
                                <p class="empty__description">A menu is a list of links the site draws in one place, such as its header or footer.</p>
                            </div>
                            <div class="empty__actions">
                                <a class="btn btn--primary" href="<?= $view->escape($view->url('menu-add')) ?>"><?= $view->icon('plus') ?><span>Add your first menu</span></a>
                            </div>
                        </div>
                    </div>
                </div>
<?php else: ?>
<?php $state = $menu['state']; ?>
                <nav class="tabs tabs--underline mb--md" aria-label="Menus">
                    <div class="tabs__list">
<?php foreach ($values['menus'] as $tab): ?>
                        <a class="tabs__trigger<?= $tab['current'] ? ' tabs__trigger--active' : '' ?>" href="<?= $view->escape($view->url('menus', ['menu' => $tab['id']])) ?>"<?php if ($tab['current']): ?> aria-current="page"<?php endif ?>><span><?= $view->escape($tab['title']) ?></span></a>
<?php endforeach ?>
                    </div>
                </nav>

                <div class="card">
                    <div class="card__header card__header--row">
                        <div>
<?php
$status = match (true) {
    ! $state['live']        => ['warning', 'Not live'],
    0 === $state['changes'] => ['success', 'Live'],
    default                 => ['info', $state['changes'] . ' unpublished ' . (1 === $state['changes'] ? 'change' : 'changes')],
};
?>
                            <h2 class="card__title"><?= $view->escape($menu['title']) ?> <span class="badge badge--sm badge--<?= $status[0] ?>-muted"><?= $view->escape($status[1]) ?></span></h2>
                            <p class="card__description navmenu__handle">
                                <span class="text--mono"><?= $view->escape($menu['handle']) ?></span>
                                <button type="button" class="btn btn--ghost btn--icon btn--sm" data-copytoclipboard data-copytoclipboard-text="<?= $view->escape($menu['handle']) ?>" data-copytoclipboard-success-message="Copied" data-copytoclipboard-error-message="Copy failed" aria-label="Copy the identifier <?= $view->escape($menu['handle']) ?>" data-tooltip="Copy"><?= $view->icon('copy') ?></button>
                            </p>
<?php if (null !== $menu['description']): ?>
                            <p class="card__description"><?= $view->escape($menu['description']) ?></p>
<?php endif ?>
                        </div>
                        <div class="navmenu__side">
                            <div class="cluster cluster--xs">
                                <a class="btn btn--outline btn--sm" href="<?= $view->escape($view->url('menu-edit', ['menu' => $menu['id']])) ?>"><?= $view->icon('pencil') ?><span>Edit menu</span></a>
<?php if (! $state['live'] || $state['changes'] > 0): ?>
                                <form method="post" action="<?= $view->escape($view->url('publish', ['menu' => $menu['id']])) ?>">
                                    <?= $view->token() ?>
                                    <button type="submit" class="btn btn--primary btn--sm"><?= $view->icon('upload') ?><span>Publish</span></button>
                                </form>
<?php endif ?>
                                <div class="dropdown dropdown--right">
                                    <button type="button" class="btn btn--outline btn--icon btn--sm dropdown__trigger" aria-haspopup="menu" aria-expanded="false" aria-label="More for <?= $view->escape($menu['title']) ?>" data-toggle data-toggle-target="#menu-more" data-toggle-capture="true"><?= $view->icon('dots-vertical') ?></button>
                                    <div class="dropdown__menu" id="menu-more" role="menu">
                                        <a class="dropdown__item" role="menuitem" href="<?= $view->escape($view->url('history', ['menu' => $menu['id']])) ?>"><?= $view->icon('history') ?><span class="dropdown__item-text">History</span></a>
                                        <div class="dropdown__divider" role="separator"></div>
                                        <form method="post" action="<?= $view->escape($view->url('menu-delete', ['menu' => $menu['id']])) ?>" data-confirm="Delete this menu and every item in it? Pages and records are kept.">
                                            <?= $view->token() ?>
                                            <button type="submit" class="dropdown__item dropdown__item--destructive" role="menuitem"><?= $view->icon('trash') ?><span class="dropdown__item-text">Delete menu</span></button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                            <p class="text--xs text--muted navmenu__when">
<?php if (! $state['live']): ?>
                                Publish it once to put it on the site
<?php else: ?>
                                <a href="<?= $view->escape($view->url('history', ['menu' => $menu['id']])) ?>" title="<?= null === $state['by'] ? 'See its history' : 'By ' . $view->escape($state['by']) . '. See its history' ?>">Updated <?= $view->escape((string) $state['published']) ?></a>
<?php endif ?>
                            </p>
                        </div>
                    </div>
                    <div class="card__content">
<?php if ([] === $menu['tree']): ?>
                        <div class="empty empty--sm">
                            <div class="empty__content">
                                <h3 class="empty__title">No items yet</h3>
                                <p class="empty__description">Add a page, an address or a heading to start the menu.</p>
                            </div>
                        </div>
<?php else: ?>
                        <div data-navtree-root>
                            <div data-navtree-token hidden><?= $view->token() ?></div>
                            <?= $view->render('navigation/tree', ['menu' => $menu['id'], 'parent' => null, 'rows' => $menu['tree']]) ?>
                        </div>
<?php endif ?>
                    </div>
                    <div class="card__footer">
                        <a class="btn btn--outline" href="<?= $view->escape($view->url('item-add', ['menu' => $menu['id']])) ?>"><?= $view->icon('plus') ?><span>Add item</span></a>
                    </div>
                </div>
<?php endif ?>
